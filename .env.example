# Конфигурация PulseCast Local (Rust + Локальный ИИ + Whisper + OBS)
# Скопируйте этот файл в .env при локальном запуске Rust-сервера.

# Сетевой адрес сервера (127.0.0.1 для локального ПК, 0.0.0.0 для доступа с телефона в LAN)
PULSECAST_HOST="127.0.0.1"
PULSECAST_PORT="8080"

# Путь к каталогу статики, медиа-ассетов и файлу автосохранения профиля
PULSECAST_STATIC_DIR="static"
PULSECAST_ASSETS_DIR="assets"
PULSECAST_DATA_FILE="pulsecast_profile.json"

# Режим локального ИИ-агента: "http" (llama-server) или "embedded" (изолированный воркер pulsecast-llama-worker на llama-cpp-2)
LLM_BACKEND="http"
LLAMA_SERVER_URL="http://127.0.0.1:8081/v1/chat/completions"
LLAMA_MODEL_NAME="local-model"
LLAMA_MODEL_PATH="models/qwen2.5-3b-instruct-q4_k_m.gguf"
# Опционально: явный путь к бинарнику pulsecast-llama-worker (по умолчанию ищется рядом с pulsecast-local)
PULSECAST_LLAMA_WORKER=""

# Модуль субтитров Whisper
WHISPER_MODEL_PATH="models/ggml-base.bin"
WHISPER_LANGUAGE="ru"
WHISPER_AUTO_START="false"

# Подключение к OBS Studio (obs-websocket v5, порт 4455 по умолчанию)
OBS_WS_HOST="127.0.0.1"
OBS_WS_PORT="4455"
OBS_WS_PASSWORD=""

# Опциональные OAuth 2.0 ключи для прямого входа в чаты (Twitch, YouTube, Kick, VK Video Live)
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
KICK_CLIENT_ID=""
KICK_CLIENT_SECRET=""
VK_CLIENT_ID=""
VK_CLIENT_SECRET=""

# Переменные среды веб-превью AI Studio (не используются для сторонних облачных ИИ)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

